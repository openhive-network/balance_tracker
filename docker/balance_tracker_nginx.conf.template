#
# Homepage and endpoints of the API "HAF Block Explorer".
#
worker_processes  5;
error_log /dev/stdout info;
worker_rlimit_nofile 8192;

events {
  worker_connections 4096;
}
http {
    access_log /dev/stdout;

    # hive.rpc_form ships in the common-ci-configuration/nginx base image.
    init_by_lua_block {
        rpc_form = require "hive.rpc_form"
        rpc_arguments = dofile(ngx.config.prefix() .. "conf/rpc_arguments.lua")
    }

    # ${RESOLVER} will be replaced by the docker entrypoint script. A variable proxy_pass
    # resolves its name through it on each lookup (cached for 10s), so a recreated PostgREST
    # is followed at its new address without restarting or reloading nginx.
    resolver ${RESOLVER} valid=10s;

    server {
            listen 0.0.0.0:80 default_server;
            server_name _;

            # Set at server level, before location / runs its rewrite rules: a `rewrite ... break`
            # there ends the rewrite module's directives for the location, so a `set` after it
            # would never run for a rewritten request. No URI part, so the request URI goes
            # upstream as rewritten, the same as a literal proxy_pass would send it.
            set $postgrest_upstream http://balance-tracker-postgrest:3000;

            location / {
                    include rewrite_rules.conf;
                    # ${REWRITE_LOG} will be replaced by the docker entrypoint script.
                    # Set REWRITE_LOG=on in the environment to enable rewrite logging,
                    # otherwise it will remain disabled
                    ${REWRITE_LOG}

                    # A GET or HEAD of a function goes upstream as a form-encoded POST of the
                    # arguments the function declares (rpc_arguments.lua, generated beside
                    # rewrite_rules.conf by scripts/openapi_rewrite.sh), so a value starting with
                    # a PostgREST operator (`not.`, `eq.`, ...) reaches it as an argument; every
                    # other parameter (column filters, `select`, `order`, `limit`, `offset`)
                    # stays in the query string for PostgREST. Runs after the rewrite rules, so
                    # it sees the path segments they turn into arguments too.
                    rewrite_by_lua_block {
                        rpc_form.forward(rpc_arguments)
                    }
                    header_filter_by_lua_block {
                        rpc_form.restore_head()
                    }

                    proxy_pass $postgrest_upstream;

                    proxy_set_header Host $host;
                    proxy_set_header X-Real-IP $remote_addr;
                    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                    #default_type;
                    proxy_hide_header Content-Location;
                    proxy_set_header  Connection "";
                    proxy_http_version 1.1;
            }
    }
    server {
        listen 0.0.0.0:81;

        location /health {
            return 204;
        }
    }
}
